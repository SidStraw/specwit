{
  "name": "gov-framework-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "cli:build": "pnpm --filter @gov/cli build",
    "cli:test": "pnpm --filter @gov/cli test",
    "cli:typecheck": "pnpm --filter @gov/cli typecheck",
    "cli:pack": "pnpm --filter @gov/cli pack --out example/dist/gov-cli-0.1.0.tgz && node scripts/package-example.mjs",
    "example:demo": "pnpm cli:pack && node example/scripts/demo.mjs"
  },
  "engines": { "node": ">=22" }
}
