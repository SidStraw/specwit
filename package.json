{
  "name": "specwit-framework-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "cli:build": "pnpm --filter @sidtw/specwit build",
    "cli:test": "pnpm --filter @sidtw/specwit test",
    "cli:typecheck": "pnpm --filter @sidtw/specwit typecheck",
    "cli:pack": "node scripts/package-example.mjs",
    "example:demo": "pnpm cli:pack && node example/scripts/demo.mjs"
  },
  "engines": { "node": ">=22" }
}
