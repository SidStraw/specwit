{
  "name": "@gov/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local Observe-mode verification helper for OpenSpec workflows",
  "type": "module",
  "bin": {
    "gov": "./dist/gov.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && node scripts/licenses.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "minimist": "catalog:inlined",
    "zod": "catalog:inlined",
    "ajv": "catalog:inlined",
    "@types/minimist": "catalog:dev",
    "@types/node": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./dist/gov.mjs",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "ajv": "8.20.0",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "3.1.8",
    "json-schema-traverse": "1.0.0",
    "minimist": "1.2.8",
    "zod": "4.6.5"
  }
}
