{
  "name": "@sidtw/specwit",
  "version": "0.3.0",
  "description": "SpecWit, short for SpecWitness, connects specifications with observed behavior and verification evidence, while making remaining unknowns explicit.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "specwit": "./dist/specwit.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "MIGRATION.zh-TW.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/resources.mjs && tsdown && node scripts/licenses.mjs",
    "typecheck": "node scripts/resources.mjs && tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:openspec": "npm run build && node scripts/smoke-openspec.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "minimist": "1.2.8",
    "zod": "4.6.5",
    "ajv": "8.20.0",
    "yaml": "2.8.1",
    "@types/minimist": "1.2.5",
    "@types/node": "22.20.4",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./dist/specwit.mjs",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "ajv": "8.20.0",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "3.1.8",
    "json-schema-traverse": "1.0.0",
    "minimist": "1.2.8",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  }
}
